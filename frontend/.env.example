# Copia este archivo como .env.local y completa los valores. .env.local no se sube al repositorio.

# URL del backend ASP.NET Core (lo usa la ruta /api/login)
BACKEND_API_URL=http://localhost:5140

# Conexión directa a SQL Server (solo la usa /api/test-db, disponible en desarrollo)
DB_SERVER=localhost
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
